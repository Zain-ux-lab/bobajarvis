# Copy to .env.local (never commit it). All keys stay server-side.

# Which provider to use. Optional: if unset, the first provider with a key is used (gemini, groq, openai).
JARVIS_PROVIDER=

# Google Gemini (direct REST, generateContent). Default model checked 2026-11-09.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional second model tried only on 404/5xx; its name is shown in the UI when used.
GEMINI_FALLBACK_MODEL=

# Groq (OpenAI-compatible, json_schema strict)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI (Chat Completions, json_schema strict)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Local Whisper (whisper.cpp). Defaults: whisper-cli on PATH, ./.models/ggml-base.en.bin
WHISPER_CLI_PATH=
WHISPER_MODEL_PATH=

# Square SANDBOX (read-only order import + optional test-order seeding). Sandbox host is hard-coded.
SQUARE_ACCESS_TOKEN=
# Optional: defaults to your first active sandbox location
SQUARE_LOCATION_ID=
# Optional: whisper-server address (npm run dev starts one here)
WHISPER_SERVER_URL=
